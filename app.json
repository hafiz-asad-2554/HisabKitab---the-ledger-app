{
  "expo": {
    "name": "Hisab Kitab",
    "slug": "hisabkitab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/hisabkitab-logo.png",
    "scheme": "hisabkitab",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.hisabkitab.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.hisabkitab.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/hisabkitab-logo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow HisabKitab to link your phone contacts to private ledgers."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F172A",
          "image": "./assets/images/hisabkitab-logo.png",
          "imageWidth": 76
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-sharing",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow HisabKitab to choose a contact profile photo from your gallery.",
          "cameraPermission": "Allow HisabKitab to take a contact profile photo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fd74d710-ccc7-4e2c-ad8b-f9f95ae361a5"
      }
    },
    "owner": "hafiz-asad-2554"
  }
}
