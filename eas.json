{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_NO_DOCTOR": "true",
        "NODE_ENV": "production"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "env": {
        "EXPO_NO_DOCTOR": "true",
        "NODE_ENV": "production"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "production-apk": {
      "distribution": "internal",
      "env": {
        "EXPO_NO_DOCTOR": "true",
        "NODE_ENV": "production"
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}
